{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resort Rating Record (LLM-only subjective ratings)",
  "type": "object",
  "required": [
    "resort_id",
    "snow_reliability", "family_friendliness", "value_for_money",
    "confidence", "reason_snow", "reason_family", "reason_value"
  ],
  "properties": {
    "resort_id": { "type": "string", "minLength": 1 },
    "snow_reliability": { "type": "integer", "minimum": 1, "maximum": 10 },
    "family_friendliness": { "type": "integer", "minimum": 1, "maximum": 10 },
    "value_for_money": { "type": "integer", "minimum": 1, "maximum": 10 },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "reason_snow": { "type": "string", "minLength": 1 },
    "reason_family": { "type": "string", "minLength": 1 },
    "reason_value": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
