{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Restaurant Record (OSM + menu extraction)",
  "type": "object",
  "required": [
    "name", "country", "region", "lat", "lon", "restaurant_type"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "region": { "type": "string", "minLength": 1 },
    "lat": { "type": "number", "minimum": 43, "maximum": 49 },
    "lon": { "type": "number", "minimum": 4, "maximum": 17 },
    "elevation_m": { "type": ["integer", "null"], "minimum": 0, "maximum": 4500 },
    "restaurant_type": { "type": "string", "enum": ["self_service", "hut", "restaurant"] },
    "ski_area_hint": { "type": ["string", "null"] },
    "osm_id": { "type": ["integer", "null"] },
    "osm_type": { "type": ["string", "null"], "enum": ["node", "way", "relation", null] },
    "website": { "type": ["string", "null"] },
    "lunch_main_eur": { "type": ["number", "null"] },
    "lunch_drink_eur": { "type": ["number", "null"] },
    "price_level": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
    "confidence": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
    "reason_price": { "type": ["string", "null"] },
    "price_source": { "type": ["string", "null"], "enum": ["menu_card", "country_statistics_estimate", null] },
    "is_estimate": { "type": ["boolean", "null"] },
    "menu_url": { "type": ["string", "null"] },
    "price_source_detail": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
