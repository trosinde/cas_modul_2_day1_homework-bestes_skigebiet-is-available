{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validation Flag Row (validation_flags.csv)",
  "type": "object",
  "x-column-order": ["item_type", "item_id", "level", "check_id", "attribute", "severity", "message"],
  "required": ["item_type", "item_id", "level", "check_id", "severity", "message"],
  "properties": {
    "item_type": { "type": "string" },
    "item_id": { "type": "string" },
    "level": { "type": "string" },
    "check_id": { "type": "string" },
    "attribute": { "type": ["string", "null"] },
    "severity": { "type": "string", "enum": ["info", "warning", "error"] },
    "message": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
