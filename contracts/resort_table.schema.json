{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resort Table Row (resorts.csv)",
  "type": "object",
  "x-primary-key": ["resort_id"],
  "x-column-order": [
    "resort_id", "name", "country", "region", "lat", "lon",
    "top_elevation_m", "top_elevation_m_sd", "top_elevation_m_range",
    "base_elevation_m", "base_elevation_m_sd", "base_elevation_m_range",
    "slope_km", "slope_km_sd", "slope_km_range",
    "day_pass_adult_eur", "day_pass_adult_eur_sd", "day_pass_adult_eur_range",
    "day_pass_youth16_eur", "day_pass_youth16_eur_sd", "day_pass_youth16_eur_range",
    "day_pass_child13_eur", "day_pass_child13_eur_sd", "day_pass_child13_eur_range",
    "age_category_16", "age_category_16_agreement",
    "age_category_13", "age_category_13_agreement",
    "family_pass_eur", "family_pass_eur_sd", "family_pass_eur_range",
    "family_pass_conditions",
    "drive_time_min", "drive_time_min_sd", "drive_time_min_range",
    "drive_distance_km", "drive_distance_km_sd", "drive_distance_km_range",
    "size_class", "size_class_agreement",
    "snow_reliability", "snow_reliability_sd", "snow_reliability_range",
    "family_friendliness", "family_friendliness_sd", "family_friendliness_range",
    "value_for_money", "value_for_money_sd", "value_for_money_range",
    "confidence", "confidence_agreement",
    "reason_snow", "reason_family", "reason_value",
    "n_runs_valid",
    "source_coords", "source_driving", "source_prices", "source_physical", "source_ratings"
  ],
  "required": ["resort_id", "name", "country", "region", "lat", "lon", "n_runs_valid"],
  "properties": {
    "resort_id": { "type": "string", "pattern": "^[a-z]{2}-.+" },
    "name": { "type": "string", "minLength": 1 },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "region": { "type": "string", "minLength": 1 },
    "lat": { "type": "number", "minimum": 43, "maximum": 49 },
    "lon": { "type": "number", "minimum": 4, "maximum": 17 },
    "top_elevation_m": { "type": ["number", "null"] },
    "top_elevation_m_sd": { "type": ["number", "null"], "minimum": 0 },
    "top_elevation_m_range": { "type": ["number", "null"], "minimum": 0 },
    "base_elevation_m": { "type": ["number", "null"] },
    "base_elevation_m_sd": { "type": ["number", "null"], "minimum": 0 },
    "base_elevation_m_range": { "type": ["number", "null"], "minimum": 0 },
    "slope_km": { "type": ["number", "null"] },
    "slope_km_sd": { "type": ["number", "null"], "minimum": 0 },
    "slope_km_range": { "type": ["number", "null"], "minimum": 0 },
    "day_pass_adult_eur": { "type": ["number", "null"] },
    "day_pass_adult_eur_sd": { "type": ["number", "null"], "minimum": 0 },
    "day_pass_adult_eur_range": { "type": ["number", "null"], "minimum": 0 },
    "day_pass_youth16_eur": { "type": ["number", "null"] },
    "day_pass_youth16_eur_sd": { "type": ["number", "null"], "minimum": 0 },
    "day_pass_youth16_eur_range": { "type": ["number", "null"], "minimum": 0 },
    "day_pass_child13_eur": { "type": ["number", "null"] },
    "day_pass_child13_eur_sd": { "type": ["number", "null"], "minimum": 0 },
    "day_pass_child13_eur_range": { "type": ["number", "null"], "minimum": 0 },
    "age_category_16": { "type": ["string", "null"] },
    "age_category_16_agreement": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "age_category_13": { "type": ["string", "null"] },
    "age_category_13_agreement": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "family_pass_eur": { "type": ["number", "null"] },
    "family_pass_eur_sd": { "type": ["number", "null"], "minimum": 0 },
    "family_pass_eur_range": { "type": ["number", "null"], "minimum": 0 },
    "family_pass_conditions": { "type": ["string", "null"] },
    "drive_time_min": { "type": ["number", "null"] },
    "drive_time_min_sd": { "type": ["number", "null"], "minimum": 0 },
    "drive_time_min_range": { "type": ["number", "null"], "minimum": 0 },
    "drive_distance_km": { "type": ["number", "null"] },
    "drive_distance_km_sd": { "type": ["number", "null"], "minimum": 0 },
    "drive_distance_km_range": { "type": ["number", "null"], "minimum": 0 },
    "size_class": { "type": ["string", "null"], "enum": ["small", "medium", "large", null] },
    "size_class_agreement": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "snow_reliability": { "type": ["number", "null"] },
    "snow_reliability_sd": { "type": ["number", "null"], "minimum": 0 },
    "snow_reliability_range": { "type": ["number", "null"], "minimum": 0 },
    "family_friendliness": { "type": ["number", "null"] },
    "family_friendliness_sd": { "type": ["number", "null"], "minimum": 0 },
    "family_friendliness_range": { "type": ["number", "null"], "minimum": 0 },
    "value_for_money": { "type": ["number", "null"] },
    "value_for_money_sd": { "type": ["number", "null"], "minimum": 0 },
    "value_for_money_range": { "type": ["number", "null"], "minimum": 0 },
    "confidence": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
    "confidence_agreement": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "reason_snow": { "type": ["string", "null"] },
    "reason_family": { "type": ["string", "null"] },
    "reason_value": { "type": ["string", "null"] },
    "n_runs_valid": { "type": "integer", "minimum": 0, "maximum": 3 },
    "source_coords": { "type": ["string", "null"] },
    "source_driving": { "type": ["string", "null"] },
    "source_prices": { "type": ["string", "null"] },
    "source_physical": { "type": ["string", "null"] },
    "source_ratings": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
