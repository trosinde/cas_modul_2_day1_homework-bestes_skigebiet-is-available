{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resort Runs Row (resorts_runs.csv)",
  "type": "object",
  "x-primary-key": ["resort_id", "run"],
  "x-column-order": [
    "resort_id", "run", "name", "country", "region", "lat", "lon",
    "top_elevation_m", "base_elevation_m", "slope_km",
    "day_pass_adult_eur", "day_pass_youth16_eur", "day_pass_child13_eur",
    "age_category_16", "age_category_13",
    "family_pass_eur", "family_pass_conditions",
    "drive_time_min", "drive_distance_km",
    "snow_reliability", "family_friendliness", "value_for_money",
    "confidence", "reason_snow", "reason_family", "reason_value"
  ],
  "required": ["resort_id", "run"],
  "properties": {
    "resort_id": { "type": "string", "pattern": "^[a-z]{2}-.+" },
    "run": { "type": "integer", "minimum": 1, "maximum": 3 },
    "name": { "type": "string" },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "region": { "type": "string" },
    "lat": { "type": ["number", "null"] },
    "lon": { "type": ["number", "null"] },
    "top_elevation_m": { "type": ["integer", "null"] },
    "base_elevation_m": { "type": ["integer", "null"] },
    "slope_km": { "type": ["number", "null"] },
    "day_pass_adult_eur": { "type": ["number", "null"] },
    "day_pass_youth16_eur": { "type": ["number", "null"] },
    "day_pass_child13_eur": { "type": ["number", "null"] },
    "age_category_16": { "type": ["string", "null"] },
    "age_category_13": { "type": ["string", "null"] },
    "family_pass_eur": { "type": ["number", "null"] },
    "family_pass_conditions": { "type": ["string", "null"] },
    "drive_time_min": { "type": ["number", "null"] },
    "drive_distance_km": { "type": ["number", "null"] },
    "snow_reliability": { "type": ["integer", "null"] },
    "family_friendliness": { "type": ["integer", "null"] },
    "value_for_money": { "type": ["integer", "null"] },
    "confidence": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
    "reason_snow": { "type": ["string", "null"] },
    "reason_family": { "type": ["string", "null"] },
    "reason_value": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
